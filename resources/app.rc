1 ICON "assets\\krun.ico"

1 24 "resources\\app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,2,0
PRODUCTVERSION 0,1,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "KRun Open Source Project\0"
            VALUE "FileDescription", "KRun - Lightweight Windows Launcher\0"
            VALUE "FileVersion", "0.1.2\0"
            VALUE "InternalName", "KRun\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 KRun contributors\0"
            VALUE "OriginalFilename", "KRun.exe\0"
            VALUE "ProductName", "KRun\0"
            VALUE "ProductVersion", "0.1.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
